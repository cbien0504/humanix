# -----------------------------------------------------------------------------
# docker compose settings. Copy to .env (git-ignored) and change EVERY value.
# SQL Server passwords: at least 8 characters with upper case, lower case, digits
# and symbols; do not use a single quote (').
# -----------------------------------------------------------------------------
MSSQL_SA_PASSWORD=Change-Me-Sa-2026!
APP_DB_PASSWORD=Change-Me-App-2026!
# Key for integration clients (X-API-Key header); leave empty to disable the API key
HRM_API_KEY=change-me-to-a-long-random-string
# Ports published on the host
APP_PORT=8080
DB_PORT=1433
# Show the demo accounts box on the login page (set false outside demos)
HRM_SHOW_DEMO_ACCOUNTS=true
# Memory cap for SQL Server (MB); 2048 is enough for the demo data
MSSQL_MEMORY_LIMIT_MB=2048
# true = drop and recreate schema + demo data on the next "up"
FORCE_RESET=false
