<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
    <description>HRM formatting functions (java.time aware)</description>
    <tlib-version>1.0</tlib-version>
    <short-name>h</short-name>
    <uri>http://hrm.example.com/functions</uri>
    <function>
        <name>date</name>
        <function-class>com.hrm.web.Formats</function-class>
        <function-signature>java.lang.String date(java.time.LocalDate)</function-signature>
    </function>
    <function>
        <name>dateTime</name>
        <function-class>com.hrm.web.Formats</function-class>
        <function-signature>java.lang.String dateTime(java.time.LocalDateTime)</function-signature>
    </function>
    <function>
        <name>time</name>
        <function-class>com.hrm.web.Formats</function-class>
        <function-signature>java.lang.String time(java.time.LocalDateTime)</function-signature>
    </function>
    <function>
        <name>instant</name>
        <function-class>com.hrm.web.Formats</function-class>
        <function-signature>java.lang.String instant(java.time.Instant)</function-signature>
    </function>
    <function>
        <name>money</name>
        <function-class>com.hrm.web.Formats</function-class>
        <function-signature>java.lang.String money(java.lang.Number)</function-signature>
    </function>
    <function>
        <name>number</name>
        <function-class>com.hrm.web.Formats</function-class>
        <function-signature>java.lang.String number(java.lang.Number)</function-signature>
    </function>
</taglib>
