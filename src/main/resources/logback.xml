<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging: SLF4J API + Logback.
  * Every line carries the request id and user from the MDC (set by RequestContextFilter),
    so one id shown on an error page finds the whole request in the log.
  * hrm.log    – application log, rolled daily / at 20 MB, 30 days kept
  * audit.log  – security-relevant actions (logger "AUDIT")
  Level and directory can be changed without rebuilding: HRM_LOG_LEVEL, HRM_LOG_DIR,
  HRM_CONSOLE_LEVEL (console threshold – the CLI import tool sets WARN to keep its report readable).
-->
<configuration scan="false">
    <property name="LOG_DIR" value="${HRM_LOG_DIR:-${catalina.base:-.}/logs}"/>
    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-system}] [%X{user:--}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${HRM_CONSOLE_LEVEL:-INFO}</level>
        </filter>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/hrm.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/hrm.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/audit.%d{yyyy-MM}.log.gz</fileNamePattern>
            <maxHistory>24</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{requestId:-system}] [%X{user:--}] %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="com.hrm" level="${HRM_LOG_LEVEL:-INFO}"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="com.microsoft.sqlserver" level="WARN"/>
    <logger name="org.apache.poi" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
